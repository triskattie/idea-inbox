# Idea Inbox configuration template
IDEA_INBOX_ENV=development
IDEA_INBOX_DATABASE_URL=sqlite:///./data/idea-inbox.sqlite3
# Alternative: set IDEA_INBOX_SQLITE_PATH instead of IDEA_INBOX_DATABASE_URL.
IDEA_INBOX_SQLITE_PATH=
IDEA_INBOX_LOG_LEVEL=INFO

# Optional model provider config. Leave empty for local/mock development.
IDEA_INBOX_CHAT_PROVIDER=mock
IDEA_INBOX_EMBEDDING_PROVIDER=mock
IDEA_INBOX_OPENAI_BASE_URL=
IDEA_INBOX_OPENAI_API_KEY=
IDEA_INBOX_OPENAI_CHAT_MODEL=
IDEA_INBOX_OPENAI_EMBEDDING_MODEL=

# Connector secrets
IDEA_INBOX_API_KEY=
IDEA_INBOX_TELEGRAM_BOT_TOKEN=
IDEA_INBOX_DISCORD_BOT_TOKEN=
IDEA_INBOX_EMAIL_IMAP_URL=
IDEA_INBOX_EMAIL_USERNAME=
IDEA_INBOX_EMAIL_PASSWORD=
